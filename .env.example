# Copy this file to .env in the repository root and fill in real values.
# Never commit .env — it is gitignored.
# Every key the app needs must be documented here.

# App
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
SERVE_STATIC_FRONTEND=false
FRONTEND_DIST_PATH=apps/frontend/dist

# AWS / DynamoDB
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE_NAME=ddac-projects
# Optional for local DynamoDB, e.g. http://localhost:8000
DYNAMODB_ENDPOINT=

# Task 2 serverless Victim/Volunteer service
# The deployed Lambda uses the AWS Academy LabRole; do not create a separate IAM role.
SERVERLESS_SERVICE_NAME=victim-volunteer-service
SERVERLESS_ALLOWED_ROLES=admin,reliefCoordinator
# Set by CloudFormation in Lambda. Leave empty for local development and tests.
VICTIM_VOLUNTEER_EVENTS_TOPIC_ARN=
# Demonstration-only switch for showing the SQS retry and dead-letter queue path.
SIMULATE_EVENT_PROCESSING_FAILURE=false

# Frontend. Leave empty to use the Vite proxy target from APP_URL / APP_PORT.
VITE_API_BASE_URL=

# Auth
JWT_SECRET=development-only-secret-change-before-production
JWT_EXPIRES_IN=7d
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=Admin123!
AUTH_BOOTSTRAP_NAME=System Administrator

# Add project-specific variables below this line
