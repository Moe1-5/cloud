# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
# Every key the app needs must be documented here.

# App
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

