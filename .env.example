# Copy this file to .env in the repository root and fill in real values.
# Never commit .env — it is gitignored.
# Every key the app needs must be documented here.

# App
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
SERVE_STATIC_FRONTEND=false
FRONTEND_DIST_PATH=apps/frontend/dist

# AWS / DynamoDB
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE_NAME=ddac-projects
# Optional for local DynamoDB, e.g. http://localhost:8000
DYNAMODB_ENDPOINT=

# Frontend. Leave empty to use the Vite proxy target from APP_URL / APP_PORT.
VITE_API_BASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Add project-specific variables below this line
